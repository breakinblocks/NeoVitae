{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:component",
    "component": "neovitae:sigil_activated",
    "cases": [
      {
        "when": true,
        "model": {
          "type": "minecraft:select",
          "property": "minecraft:component",
          "component": "neovitae:spiritus_type",
          "cases": [
            {
              "when": "ruina",
              "model": {
                "type": "minecraft:model",
                "model": "neovitae:item/variant/sentient_scythe_ruina"
              }
            },
            {
              "when": "nihilum",
              "model": {
                "type": "minecraft:model",
                "model": "neovitae:item/variant/sentient_scythe_nihilum"
              }
            },
            {
              "when": "invictus",
              "model": {
                "type": "minecraft:model",
                "model": "neovitae:item/variant/sentient_scythe_invictus"
              }
            },
            {
              "when": "vindicta",
              "model": {
                "type": "minecraft:model",
                "model": "neovitae:item/variant/sentient_scythe_vindicta"
              }
            }
          ],
          "fallback": {
            "type": "minecraft:model",
            "model": "neovitae:item/variant/sentient_scythe_activated"
          }
        }
      }
    ],
    "fallback": {
      "type": "minecraft:model",
      "model": "neovitae:item/variant/sentient_scythe_deactivated"
    }
  }
}
